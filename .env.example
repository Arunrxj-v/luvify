# ---------------------------------------------------------------------------
# Luvify - environment configuration
# Copy to `.env` (`cp .env.example .env`) and adjust. Everything below works
# out of the box with AI_PROVIDER=mock and a local SQLite database.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL (recommended / production target):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luvify?schema=public"
#   then run: npm run db:postgres:migrate
#
# SQLite (zero-setup local demo, default):
#   DATABASE_URL="file:./dev.db"          <- relative to prisma/sqlite/schema.prisma
#   then run: npm run db:sqlite
DATABASE_URL="file:./dev.db"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# How many proxy hops in front of Node are trusted for the client IP that the
# auth rate limiter keys on. `1` matches the hosted Nginx / Tailscale layout.
# Set to `false` when Node is exposed directly - otherwise X-Forwarded-For can
# be spoofed to mint a fresh rate-limit bucket per request.
TRUST_PROXY=1
# Secret used to sign Google OAuth `state` blobs (change in production!).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# With NODE_ENV=production the server refuses to start while this still holds
# the placeholder value below.
JWT_SECRET=dev-only-change-me
# Public base URL of this server - used to build published site + preview URLs
PUBLIC_BASE_URL=http://localhost:4000
# Directory used by the local hosting provider to write published site files
STORAGE_DIR=.storage

# --- Authentication ---------------------------------------------------------
# Frontend origin the Google OAuth callback redirects back to. Defaults to the
# first entry of CORS_ORIGINS when left blank.
APP_BASE_URL=http://localhost:5173
# Browser session lifetime, in days. The credential is an opaque random token
# held in an httpOnly cookie; only its SHA-256 is stored server-side.
AUTH_SESSION_DAYS=14
# `Secure` on the session cookie. Leave blank to use the default:
#   true when NODE_ENV=production, false otherwise.
# Set to `false` ONLY if a production build is served over plain http - a
# Secure cookie is then dropped by the browser and every login silently fails.
AUTH_COOKIE_SECURE=
# Requests allowed per 5 minutes per IP on /api/auth before HTTP 429.
AUTH_RATE_LIMIT_MAX=30
# Cookie names (rarely changed; listed for completeness)
SESSION_COOKIE_NAME=luvify_session
OAUTH_COOKIE_NAME=luvify_oauth_state

# Google OAuth / OpenID Connect - "Continue with Google".
# SERVER-SIDE ONLY: read by apps/server/src/env.ts inside Express and sent only
# to Google's token endpoint from the server. Like the Gemini key above, never
# expose these as VITE_* variables, never inline them in the React bundle and
# never commit real values - .env is git-ignored, this file is not.
#
# Setup:
#   1. https://console.cloud.google.com/apis/credentials -> OAuth client (Web)
#   2. Authorized JavaScript origin: APP_BASE_URL
#   3. Authorized redirect URI:      GOOGLE_OAUTH_REDIRECT_URI
#   4. Configure the OAuth consent screen and add your account as a test user.
# All three must be set; when any is blank, "Continue with Google" is hidden
# and GET /api/auth/google answers 503. Email/password auth is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Optional: OAuth state lifetime in seconds (default 600)
# OAUTH_STATE_SECONDS=600

# --- AI provider ------------------------------------------------------------
# gemini     = real AI via Google Gemini (default; requires GOOGLE_GENERATIVE_AI_API_KEY)
# openrouter = real AI via OpenRouter (requires OPENROUTER_API_KEY)
# mock       = offline deterministic fixture used by the test suite
AI_PROVIDER=gemini

# Google Gemini - SERVER-SIDE ONLY: read by apps/server/src/env.ts and handed
# to the official @google/genai SDK on the backend. Never exposed to React,
# Vite, browser JavaScript, localStorage, sessionStorage or any API response,
# and never embedded in generated website code. Vite inlines only VITE_*-
# prefixed variables, so do NOT rename this to
# VITE_GOOGLE_GENERATIVE_AI_API_KEY - that would publish it to every visitor.
# Put your real key in .env (git-ignored), never in this file.
GOOGLE_GENERATIVE_AI_API_KEY=
# Gemini model id - see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Fallback model: after GEMINI_MODEL exhausts its retries on a transient
# failure (429 / 5xx / network), the SAME request runs once more against this
# model - identical prompts, JSON mode, temperature and pipeline. Never used
# for auth, invalid-request or configuration errors. Set blank to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional overrides
# GEMINI_TIMEOUT_MS=60000
# GEMINI_MAX_RETRIES=2
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenRouter - alternative real provider (AI_PROVIDER=openrouter).
# SERVER-SIDE ONLY, same rules as the Gemini key above.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OpenRouter model id - see https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=60000
# OPENROUTER_MAX_RETRIES=2
# AI_MAX_TOKENS=4096

# Ollama / local models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=120000

# Shared AI tuning (used by every real provider)
AI_TEMPERATURE=0.6
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=60000

# --- Frontend (Vite) --------------------------------------------------------
# Leave empty when the API is proxied through the Vite dev server (default).
VITE_API_BASE_URL=

# --- Business / commerce (optional, Phase 2 architecture hooks) -------------
# Payments are intentionally not processed in the MVP. Configure a provider
# later (stripe | paddles | manual) - see README "Publishing & commerce".
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=

# Hosting provider used by the publish pipeline: local | vercel | netlify
HOSTING_PROVIDER=local
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
