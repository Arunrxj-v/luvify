# ---------------------------------------------------------------------------
# Luvify - environment configuration
# Copy to `.env` (`cp .env.example .env`) and adjust. Everything below works
# out of the box with AI_PROVIDER=mock and a local SQLite database.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL (recommended / production target):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/luvify?schema=public"
#   then run: npm run db:postgres:migrate
#
# SQLite (zero-setup local demo, default):
#   DATABASE_URL="file:./dev.db"          <- relative to prisma/sqlite/schema.prisma
#   then run: npm run db:sqlite
DATABASE_URL="file:./dev.db"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Secret used to sign demo session tokens (change in production!)
JWT_SECRET=dev-only-change-me
# Public base URL of this server - used to build published site + preview URLs
PUBLIC_BASE_URL=http://localhost:4000
# Directory used by the local hosting provider to write published site files
STORAGE_DIR=.storage

# --- AI provider ------------------------------------------------------------
# openrouter = real hosted AI (requires OPENROUTER_API_KEY below)
# ollama     = real local AI through the Ollama server (no key required)
# mock       = offline deterministic fixture used by the test suite
# Switching providers is this one line - no code change.
AI_PROVIDER=ollama

# OpenRouter - powers website generation and chat.
# SERVER-SIDE ONLY: read by apps/server/src/env.ts and used to build the
# Authorization header on the backend. Never exposed to React, Vite, browser
# JavaScript, localStorage, sessionStorage or any API response, and never
# embedded in generated website code. Vite inlines only VITE_*-prefixed
# variables, so do NOT rename this to VITE_OPENROUTER_API_KEY.
# Put your real key in .env (git-ignored), never in this file.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OpenRouter model id - see https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=60000
# OPENROUTER_MAX_RETRIES=2
# AI_MAX_TOKENS=4096

# Ollama / local models - SERVER-SIDE ONLY, used when AI_PROVIDER=ollama.
# Read by apps/server/src/env.ts; the backend calls Ollama directly so the
# browser never reaches localhost:11434. Local Ollama needs no API key, so the
# OpenRouter key above is never sent here. Never prefix these with VITE_.
# Requires the Ollama app to be running and the model to be installed
# (`ollama list`, `ollama pull <model>`).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:4b
# qwen3.5:4b is a thinking model: `none` stops it spending its token budget (and
# a minute of wall clock on Apple Silicon) on reasoning before the answer.
# Use `low`/`medium`/`high` for more reasoning, or `auto` for the model default.
OLLAMA_REASONING_EFFORT=none
# Local generation on an M1 is much slower than a hosted API - leave headroom.
OLLAMA_TIMEOUT_MS=900000
# Optional overrides
# OLLAMA_MAX_RETRIES=2

# Google Gemini - SERVER-SIDE ONLY. Leave blank unless a Gemini provider is
# wired into apps/server. This value is read only from apps/server/src/env.ts
# and is never imported by apps/web: Vite inlines only VITE_*-prefixed vars, so
# a key here can never reach the browser bundle. Do not rename it to
# VITE_GOOGLE_GENERATIVE_AI_API_KEY - that would publish it to every visitor.
GOOGLE_GENERATIVE_AI_API_KEY=

# Shared AI tuning
AI_TEMPERATURE=0.6
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=60000

# --- Frontend (Vite) --------------------------------------------------------
# Leave empty when the API is proxied through the Vite dev server (default).
VITE_API_BASE_URL=

# --- Business / commerce (optional, Phase 2 architecture hooks) -------------
# Payments are intentionally not processed in the MVP. Configure a provider
# later (stripe | paddles | manual) - see README "Publishing & commerce".
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=

# Hosting provider used by the publish pipeline: local | vercel | netlify
HOSTING_PROVIDER=local
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
